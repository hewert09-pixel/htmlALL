<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Шпаргалка ДЭ — КОД 09.02.06-1-2026</title>
<style>
  :root{
    --bg:#eef2f7;
    --card:#ffffff;
    --text:#1e293b;
    --muted:#64748b;
    --accent:#2563eb;
    --accent-2:#0ea5e9;
    --accent-soft:#e0edff;
    --border:#e2e8f0;
    --code-bg:#0f172a;
    --code-text:#e2e8f0;
    --code-head:#1e293b;
    --warn-bg:#fff7ed;
    --warn-bd:#fdba74;
    --warn-tx:#9a3412;
    --note-bg:#f0f9ff;
    --note-bd:#7dd3fc;
    --note-tx:#075985;
    --sidebar:#0b1220;
    --sidebar-hover:#1e293b;
    --radius:14px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:"Segoe UI",-apple-system,BlinkMacSystemFont,"Helvetica Neue",Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    line-height:1.65;
    font-size:15.5px;
  }

  /* ---------- LAYOUT ---------- */
  .layout{display:flex;min-height:100vh;}

  /* ---------- SIDEBAR ---------- */
  .sidebar{
    width:310px;
    flex:0 0 310px;
    background:var(--sidebar);
    color:#cbd5e1;
    position:sticky;
    top:0;
    height:100vh;
    overflow-y:auto;
    padding:26px 20px 60px;
    scrollbar-width:thin;
    scrollbar-color:#334155 transparent;
  }
  .sidebar::-webkit-scrollbar{width:8px;}
  .sidebar::-webkit-scrollbar-thumb{background:#334155;border-radius:4px;}

  .brand{
    display:flex;align-items:center;gap:10px;
    font-weight:700;font-size:17px;color:#fff;
    padding-bottom:16px;margin-bottom:18px;
    border-bottom:1px solid #1e293b;
    letter-spacing:.2px;
  }
  .brand .logo{
    width:34px;height:34px;border-radius:10px;flex:0 0 34px;
    background:linear-gradient(135deg,#3b82f6,#06b6d4);
    display:flex;align-items:center;justify-content:center;
    font-size:17px;
  }
  .brand small{display:block;font-weight:400;font-size:11px;color:#64748b;letter-spacing:.4px;text-transform:uppercase;}

  .nav-title{
    font-size:11px;text-transform:uppercase;letter-spacing:1.4px;
    color:#64748b;font-weight:700;
    margin:22px 0 8px;padding-left:8px;
  }
  .sidebar a{
    display:block;
    color:#cbd5e1;
    text-decoration:none;
    font-size:13.6px;
    padding:6px 10px;
    border-radius:8px;
    border-left:3px solid transparent;
    transition:.15s;
    line-height:1.4;
  }
  .sidebar a:hover{background:var(--sidebar-hover);color:#fff;}
  .sidebar a.active{
    background:linear-gradient(90deg,rgba(37,99,235,.28),transparent);
    border-left-color:var(--accent-2);
    color:#fff;font-weight:600;
  }

  /* ---------- MAIN ---------- */
  main{
    flex:1 1 auto;
    min-width:0;
    padding:44px 52px 100px;
    max-width:1180px;
  }

  .hero{
    background:linear-gradient(135deg,#1d4ed8 0%,#0ea5e9 55%,#06b6d4 100%);
    color:#fff;
    border-radius:20px;
    padding:38px 40px;
    margin-bottom:40px;
    box-shadow:0 18px 40px -18px rgba(29,78,216,.6);
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:"";
    position:absolute;right:-70px;top:-70px;
    width:260px;height:260px;border-radius:50%;
    background:rgba(255,255,255,.09);
  }
  .hero::before{
    content:"";
    position:absolute;right:60px;bottom:-100px;
    width:200px;height:200px;border-radius:50%;
    background:rgba(255,255,255,.07);
  }
  .hero h1{margin:0 0 10px;font-size:31px;line-height:1.25;letter-spacing:-.4px;position:relative;}
  .hero p{margin:0;opacity:.94;font-size:15.5px;max-width:760px;position:relative;}
  .hero .chips{margin-top:20px;display:flex;flex-wrap:wrap;gap:9px;position:relative;}
  .chip{
    background:rgba(255,255,255,.18);
    border:1px solid rgba(255,255,255,.3);
    padding:5px 13px;border-radius:999px;
    font-size:12.5px;font-weight:600;letter-spacing:.2px;
    backdrop-filter:blur(4px);
  }

  /* ---------- MODULE SECTIONS ---------- */
  .module{
    margin:0 0 52px;
    scroll-margin-top:24px;
  }
  .module-head{
    display:flex;align-items:center;gap:14px;
    margin-bottom:22px;
    padding-bottom:14px;
    border-bottom:2px solid var(--border);
  }
  .module-num{
    flex:0 0 auto;
    background:linear-gradient(135deg,#2563eb,#0ea5e9);
    color:#fff;
    font-weight:800;
    font-size:13px;
    letter-spacing:.8px;
    padding:7px 14px;
    border-radius:10px;
    box-shadow:0 6px 14px -6px rgba(37,99,235,.7);
  }
  .module-head h2{
    margin:0;
    font-size:23px;
    letter-spacing:-.3px;
    color:#0f172a;
  }

  /* ---------- MACHINE / TASK CARD ---------- */
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:26px 28px;
    margin-bottom:24px;
    box-shadow:0 2px 10px -6px rgba(15,23,42,.14);
    scroll-margin-top:20px;
  }
  .card > h3{
    margin:0 0 6px;
    font-size:18.5px;
    color:#0f172a;
    display:flex;align-items:center;gap:10px;
    letter-spacing:-.2px;
  }
  .card > h3 .ico{font-size:19px;line-height:1;}
  .card .sub{
    color:var(--muted);
    font-size:13.5px;
    margin:0 0 16px;
  }

  .step{
    margin-top:22px;
    padding-top:18px;
    border-top:1px dashed var(--border);
  }
  .step:first-of-type{border-top:none;padding-top:6px;}
  .step h4{
    margin:0 0 10px;
    font-size:15.5px;
    color:#1d4ed8;
    display:flex;align-items:center;gap:8px;
    font-weight:700;
  }
  .step h4::before{
    content:"";
    width:7px;height:7px;border-radius:50%;
    background:var(--accent-2);
    flex:0 0 7px;
    box-shadow:0 0 0 4px rgba(14,165,233,.15);
  }

  /* ---------- CODE BLOCKS ---------- */
  .codeblock{
    border-radius:12px;
    overflow:hidden;
    margin:12px 0 0;
    background:var(--code-bg);
    box-shadow:0 8px 22px -14px rgba(15,23,42,.9);
    border:1px solid #1e293b;
  }
  .codeblock__head{
    display:flex;align-items:center;justify-content:space-between;
    background:var(--code-head);
    padding:8px 14px;
    border-bottom:1px solid #0b1220;
  }
  .lang{
    font-size:11px;
    font-weight:700;
    letter-spacing:1.2px;
    text-transform:uppercase;
    color:#7dd3fc;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  }
  .dots{display:flex;gap:6px;}
  .dots i{
    width:9px;height:9px;border-radius:50%;display:block;
    background:#475569;
  }
  .dots i:nth-child(1){background:#f87171;}
  .dots i:nth-child(2){background:#fbbf24;}
  .dots i:nth-child(3){background:#34d399;}

  pre{
    margin:0;
    padding:16px 18px;
    overflow-x:auto;
    background:transparent;
  }
  pre code{
    font-family:ui-monospace,SFMono-Regular,"Cascadia Code",Menlo,Consolas,"Liberation Mono",monospace;
    font-size:13.2px;
    line-height:1.72;
    color:var(--code-text);
    white-space:pre;
    tab-size:2;
  }
  pre::-webkit-scrollbar{height:9px;}
  pre::-webkit-scrollbar-thumb{background:#334155;border-radius:4px;}

  .code-note{
    display:flex;align-items:center;gap:7px;
    font-size:12.4px;
    color:var(--warn-tx);
    background:var(--warn-bg);
    border:1px solid var(--warn-bd);
    border-left:4px solid var(--warn-bd);
    padding:7px 13px;
    border-radius:0 0 10px 10px;
    margin:-12px 0 0;
    font-weight:600;
    letter-spacing:.1px;
  }
  .code-note::before{content:"⚠";font-size:13.5px;}

  /* ---------- EXPLANATION / NOTE ---------- */
  .note{
    background:var(--note-bg);
    border:1px solid var(--note-bd);
    border-left:4px solid var(--accent-2);
    border-radius:0 10px 10px 0;
    padding:12px 16px;
    margin-top:12px;
    font-size:14.2px;
    color:#0f2f45;
  }
  .note strong{color:var(--note-tx);}
  .note .label{
    display:inline-block;
    font-size:11px;
    font-weight:800;
    letter-spacing:1px;
    text-transform:uppercase;
    color:var(--note-tx);
    margin-right:6px;
  }
  .note ul{margin:8px 0 0;padding-left:20px;}
  .note li{margin-bottom:4px;}

  /* ---------- LISTS ---------- */
  .card ul, .card ol{margin:8px 0;padding-left:22px;}
  .card li{margin-bottom:5px;}
  .card li::marker{color:var(--accent);font-weight:700;}

  /* ---------- INLINE CODE ---------- */
  code.inline{
    background:#eef2f7;
    border:1px solid #dbe3ec;
    color:#0f172a;
    padding:1.5px 6px;
    border-radius:6px;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:12.8px;
    white-space:nowrap;
  }

  /* ---------- TABLE ---------- */
  .table-wrap{overflow-x:auto;margin-top:12px;border-radius:10px;border:1px solid var(--border);}
  table{border-collapse:collapse;width:100%;font-size:13.8px;background:#fff;}
  th,td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--border);}
  th{background:#f1f5f9;font-weight:700;color:#0f172a;font-size:12.6px;letter-spacing:.4px;text-transform:uppercase;}
  tr:last-child td{border-bottom:none;}
  tbody tr:hover{background:#f8fafc;}

  /* ---------- BADGES ---------- */
  .badge{
    display:inline-block;
    font-size:11.5px;
    font-weight:700;
    padding:3px 10px;
    border-radius:999px;
    letter-spacing:.3px;
    vertical-align:middle;
  }
  .badge.blue{background:var(--accent-soft);color:#1d4ed8;}
  .badge.green{background:#dcfce7;color:#166534;}
  .badge.amber{background:#fef3c7;color:#92400e;}
  .badge.violet{background:#ede9fe;color:#5b21b6;}

  /* ---------- BACK TO TOP ---------- */
  .to-top{
    position:fixed;
    right:26px;bottom:26px;
    width:46px;height:46px;
    border-radius:50%;
    background:linear-gradient(135deg,#2563eb,#0ea5e9);
    color:#fff;
    border:none;
    cursor:pointer;
    font-size:19px;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 10px 24px -8px rgba(37,99,235,.85);
    opacity:0;pointer-events:none;
    transition:.25s;
    z-index:50;
  }
  .to-top.show{opacity:1;pointer-events:auto;}
  .to-top:hover{transform:translateY(-3px);}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:1024px){
    .sidebar{width:250px;flex:0 0 250px;padding:20px 14px 50px;}
    main{padding:32px 26px 80px;}
    .hero{padding:30px 26px;}
    .hero h1{font-size:25px;}
  }
  @media (max-width:768px){
    .layout{flex-direction:column;}
    .sidebar{
      position:relative;width:100%;flex:none;height:auto;
      max-height:300px;padding:18px 16px 24px;
    }
    .nav-title{margin:14px 0 6px;}
    main{padding:22px 16px 70px;}
    .hero{padding:24px 20px;border-radius:16px;}
    .hero h1{font-size:21px;}
    .card{padding:20px 18px;}
    pre code{font-size:12.3px;}
  }

  @media print{
    .sidebar,.to-top{display:none;}
    main{padding:0;max-width:none;}
    .card{break-inside:avoid;box-shadow:none;}
    .hero{box-shadow:none;background:#1d4ed8 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  }
</style>
</head>
